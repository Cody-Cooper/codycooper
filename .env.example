# Server-only MailerLite API token.
MAILERLITE_API_TOKEN=

# Optional: group ID used by your newsletter/automation.
MAILERLITE_GROUP_ID=

# Optional: public Giscus discussion settings from https://giscus.app.
# Comments are hidden until repo, repository ID, and category ID are set.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
